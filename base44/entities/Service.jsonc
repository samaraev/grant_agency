{
  "name": "Service",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "short_description": {
      "type": "string"
    },
    "audience": {
      "type": "string",
      "enum": [
        "owner",
        "buyer",
        "all"
      ],
      "enumColors": [
        "red",
        "blue",
        "gray"
      ],
      "default": "all"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "planned"
      ],
      "enumColors": [
        "green",
        "yellow"
      ],
      "default": "active"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {}
  }
}