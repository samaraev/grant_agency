{
  "name": "Lead",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "owner_appraise",
        "owner_sell",
        "buyer_buy",
        "buyer_check",
        "general",
        "rent"
      ],
      "enumColors": [
        "red",
        "red",
        "blue",
        "blue",
        "gray",
        "gray"
      ],
      "description": "\u0422\u0438\u043f \u043e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u044f. rent \u2014 \u0430\u0440\u0435\u043d\u0434\u0430, \u043d\u0438\u0437\u043a\u0438\u0439 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442"
    },
    "pipeline": {
      "type": "string",
      "enum": [
        "owner_sale",
        "buyer_search",
        "rental"
      ],
      "enumColors": [
        "red",
        "blue",
        "green"
      ],
      "description": "\u0412\u043e\u0440\u043e\u043d\u043a\u0430 \u043e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u044f. \u0415\u0441\u043b\u0438 \u043d\u0435 \u0437\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u0430 \u2014 \u0432\u044b\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u0438\u0437 \u0442\u0438\u043f\u0430: owner_* \u2192 owner_sale, buyer_* \u2192 buyer_search, rent \u2192 rental, general \u2192 owner_sale"
    },
    "cluster": {
      "type": "string",
      "enum": [
        "khamovniki",
        "other"
      ],
      "enumColors": [
        "purple",
        "gray"
      ],
      "default": "other",
      "description": "\u041a\u043b\u0430\u0441\u0442\u0435\u0440 \u0440\u0430\u0431\u043e\u0442\u044b \u0430\u0433\u0435\u043d\u0442\u0441\u0442\u0432\u0430. \u041f\u0435\u0440\u0432\u044b\u0439 \u043a\u043b\u0430\u0441\u0442\u0435\u0440 \u2014 \u0425\u0430\u043c\u043e\u0432\u043d\u0438\u043a\u0438."
    },
    "person_role": {
      "type": "string",
      "enum": [
        "owner",
        "buyer",
        "tenant",
        "other"
      ],
      "enumColors": [
        "red",
        "blue",
        "gray",
        "gray"
      ],
      "description": "\u0420\u043e\u043b\u044c \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430: \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a, \u043f\u043e\u043a\u0443\u043f\u0430\u0442\u0435\u043b\u044c, \u0430\u0440\u0435\u043d\u0434\u0430\u0442\u043e\u0440, \u0434\u0440\u0443\u0433\u043e\u0435. \u0412\u044b\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u0438\u0437 \u0442\u0438\u043f\u0430 \u043e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u044f \u0438 \u0443\u0442\u043e\u0447\u043d\u044f\u0435\u0442\u0441\u044f \u0430\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u043e\u0440\u043e\u043c"
    },
    "area_flag": {
      "type": "string",
      "enum": [
        "in_target",
        "outside",
        "unknown"
      ],
      "enumColors": [
        "green",
        "red",
        "gray"
      ],
      "default": "unknown",
      "description": "\u041e\u0431\u044a\u0435\u043a\u0442 \u0432\u043d\u0443\u0442\u0440\u0438 \u0446\u0435\u043b\u0435\u0432\u043e\u0433\u043e \u043a\u043b\u0430\u0441\u0442\u0435\u0440\u0430, \u0432\u043d\u0435 \u0435\u0433\u043e \u0438\u043b\u0438 \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e"
    },
    "sell_timeline": {
      "type": "string",
      "enum": [
        "asap",
        "month",
        "quarter",
        "later",
        "undecided"
      ],
      "enumColors": [
        "red",
        "yellow",
        "blue",
        "gray",
        "gray"
      ],
      "description": "\u041a\u043e\u0433\u0434\u0430 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a \u043f\u043b\u0430\u043d\u0438\u0440\u0443\u0435\u0442 \u043f\u0440\u043e\u0434\u0430\u0436\u0443 (\u0438\u0437 \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u043e\u0439 \u0444\u043e\u0440\u043c\u044b)"
    },
    "timeframe_hint": {
      "type": "string",
      "enum": [
        "asap",
        "1_3_months",
        "3_6_months",
        "later",
        "unknown"
      ],
      "enumColors": [
        "red",
        "yellow",
        "blue",
        "gray",
        "gray"
      ],
      "description": "\u041e\u0440\u0438\u0435\u043d\u0442\u0438\u0440 \u043f\u043e \u0441\u0440\u043e\u043a\u0443, \u0437\u0430\u0444\u0438\u043a\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u0432 \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440\u0435"
    },
    "intent_rating": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "enumColors": [
        "red",
        "yellow",
        "green"
      ],
      "description": "\u041e\u0446\u0435\u043d\u043a\u0430 \u043d\u0430\u043c\u0435\u0440\u0435\u043d\u0438\u044f. \u0417\u0430\u043f\u043e\u043b\u043d\u044f\u0435\u0442\u0441\u044f \u043f\u0440\u0438 \u043a\u0432\u0430\u043b\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0438"
    },
    "agreement": {
      "type": "string",
      "enum": [
        "none",
        "agency",
        "exclusive"
      ],
      "enumColors": [
        "gray",
        "blue",
        "green"
      ],
      "default": "none",
      "description": "\u041f\u043e\u0434\u043f\u0438\u0441\u0430\u043d\u043d\u044b\u0439 \u0434\u043e\u0433\u043e\u0432\u043e\u0440: \u043d\u0435\u0442, \u0430\u0433\u0435\u043d\u0442\u0441\u043a\u0438\u0439 \u0438\u043b\u0438 \u044d\u043a\u0441\u043a\u043b\u044e\u0437\u0438\u0432\u043d\u044b\u0439"
    },
