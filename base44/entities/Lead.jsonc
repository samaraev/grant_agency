{
  "name": "Lead",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "owner_appraise",
        "owner_sell",
        "buyer_buy",
        "buyer_check",
        "general"
      ],
      "enumColors": [
        "red",
        "red",
        "blue",
        "blue",
        "gray"
      ],
      "description": "\u0422\u0438\u043f \u043e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u044f"
    },
    "cluster": {
      "type": "string",
      "enum": [
        "khamovniki",
        "other"
      ],
      "enumColors": [
        "purple",
        "gray"
      ],
      "default": "other",
      "description": "\u041a\u043b\u0430\u0441\u0442\u0435\u0440 \u0440\u0430\u0431\u043e\u0442\u044b \u0430\u0433\u0435\u043d\u0442\u0441\u0442\u0432\u0430. \u041f\u0435\u0440\u0432\u044b\u0439 \u043a\u043b\u0430\u0441\u0442\u0435\u0440 \u2014 \u0425\u0430\u043c\u043e\u0432\u043d\u0438\u043a\u0438."
    },
    "sell_timeline": {
      "type": "string",
      "enum": [
        "asap",
        "month",
        "quarter",
        "later",
        "undecided"
      ],
      "enumColors": [
        "red",
        "yellow",
        "blue",
        "gray",
        "gray"
      ],
      "description": "\u041a\u043e\u0433\u0434\u0430 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a \u043f\u043b\u0430\u043d\u0438\u0440\u0443\u0435\u0442 \u043f\u0440\u043e\u0434\u0430\u0436\u0443. \u041e\u0441\u043d\u043e\u0432\u0430 \u043a\u0432\u0430\u043b\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0438 \u0431\u0435\u0441\u0435\u0434\u044b."
    },
    "agreement": {
      "type": "string",
      "enum": [
        "none",
        "agency",
        "exclusive"
      ],
      "enumColors": [
        "gray",
        "blue",
        "green"
      ],
      "default": "none",
      "description": "\u041f\u043e\u0434\u043f\u0438\u0441\u0430\u043d\u043d\u044b\u0439 \u0434\u043e\u0433\u043e\u0432\u043e\u0440: \u043d\u0435\u0442, \u0430\u0433\u0435\u043d\u0442\u0441\u043a\u0438\u0439 \u0438\u043b\u0438 \u044d\u043a\u0441\u043a\u043b\u044e\u0437\u0438\u0432\u043d\u044b\u0439"
    },
    "building_id": {
      "type": "string",
      "description": "\u0414\u043e\u043c \u0438\u0437 \u0431\u0430\u0437\u044b, \u0435\u0441\u043b\u0438 \u0430\u0434\u0440\u0435\u0441 \u043d\u0430\u0439\u0434\u0435\u043d"
    },
    "address_text": {
      "type": "string",
      "description": "\u0410\u0434\u0440\u0435\u0441, \u043a\u0430\u043a \u0435\u0433\u043e \u0443\u043a\u0430\u0437\u0430\u043b \u0447\u0435\u043b\u043e\u0432\u0435\u043a"
    },
    "name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "preferred_contact": {
      "type": "string",
      "enum": [
        "phone",
        "telegram",
        "whatsapp"
      ],
      "enumColors": [
        "blue",
        "purple",
        "green"
      ],
      "default": "phone"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "qualified",
        "meeting_set",
        "agreement",
        "closed",
        "spam"
      ],
      "enumColors": [
        "blue",
        "yellow",
        "purple",
        "purple",
        "green",
        "green",
        "gray"
      ],
      "default": "new",
      "description": "\u0421\u0442\u0430\u0442\u0443\u0441 \u043e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u044f. qualified \u2014 \u043a\u0432\u0430\u043b\u0438\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u0431\u0435\u0441\u0435\u0434\u0430 (KPI), agreement \u2014 \u043f\u043e\u0434\u043f\u0438\u0441\u0430\u043d \u0434\u043e\u0433\u043e\u0432\u043e\u0440"
    },
    "source": {
      "type": "string",
      "description": "\u041a\u043e\u0440\u043e\u0442\u043a\u043e\u0435 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430: utm_source / medium / campaign, \u0438\u043d\u0430\u0447\u0435 referrer"
    },
    "utm_source": {
      "type": "string"
    },
    "utm_medium": {
      "type": "string"
    },
    "utm_campaign": {
      "type": "string"
    },
    "referrer": {
      "type": "string"
    },
    "page_path": {
      "type": "string",
      "description": "\u0421\u0442\u0440\u0430\u043d\u0438\u0446\u0430, \u0441 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043e \u043e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u0435"
    },
    "is_meaningful": {
      "type": "boolean",
      "default": false,
      "description": "\u041a\u0432\u0430\u043b\u0438\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u0431\u0435\u0441\u0435\u0434\u0430 \u2014 KPI \u0430\u0433\u0435\u043d\u0442\u0441\u0442\u0432\u0430. \u041e\u0442\u043c\u0435\u0447\u0430\u0435\u0442\u0441\u044f \u0430\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u043e\u0440\u043e\u043c \u0432\u0440\u0443\u0447\u043d\u0443\u044e"
    },
    "admin_notes": {
      "type": "string"
    }
  },
  "required": [
    "type",
    "name",
    "phone"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}