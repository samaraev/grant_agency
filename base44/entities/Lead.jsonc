    "commission_note": {
      "type": "string",
      "description": "\u0423\u0441\u043b\u043e\u0432\u0438\u044f \u043a\u043e\u043c\u0438\u0441\u0441\u0438\u0438 \u0442\u0435\u043a\u0441\u0442\u043e\u043c: \u043a\u0442\u043e \u043f\u043b\u0430\u0442\u0438\u0442, \u0437\u0430 \u0447\u0442\u043e, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u0438"
    },
    "expected_close_date": {
      "type": "string",
      "format": "date",
      "description": "\u041e\u0436\u0438\u0434\u0430\u0435\u043c\u0430\u044f \u0434\u0430\u0442\u0430 \u0437\u0430\u043a\u0440\u044b\u0442\u0438\u044f \u0441\u0434\u0435\u043b\u043a\u0438"
