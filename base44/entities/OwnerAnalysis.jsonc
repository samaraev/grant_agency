      "description": "\u041e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u0430"
    },
    "price_range_note": {
      "type": "string",
      "description": "\u041e\u0440\u0438\u0435\u043d\u0442\u0438\u0440 \u043f\u043e \u0446\u0435\u043d\u0435 \u2014 \u0442\u043e\u043b\u044c\u043a\u043e \u0440\u0443\u0447\u043d\u0430\u044f \u0437\u0430\u043c\u0435\u0442\u043a\u0430 \u044d\u043a\u0441\u043f\u0435\u0440\u0442\u0430, \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0440\u0430\u0441\u0447\u0451\u0442"
    },
    "liquidity": {
      "type": "string",
      "description": "\u041e\u0446\u0435\u043d\u043a\u0430 \u043b\u0438\u043a\u0432\u0438\u0434\u043d\u043e\u0441\u0442\u0438 \u043e\u0431\u044a\u0435\u043a\u0442\u0430"
    },
    "competitors": {
      "type": "string",
      "description": "\u041a\u043e\u043d\u043a\u0443\u0440\u0438\u0440\u0443\u044e\u0449\u0438\u0435 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0438 \u0441\u0441\u044b\u043b\u043a\u0438"
    },
