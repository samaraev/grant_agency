      "description": "\u0412\u043e\u0437\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u0430 \u0438 \u043e\u0442\u0432\u0435\u0442\u044b"
    },
    "recommended_strategy": {
      "type": "string",
      "description": "\u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u043c\u0430\u044f \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u044f"
