      "type": "string",
      "description": "\u041f\u043e\u0447\u0435\u043c\u0443 \u043e\u0431\u044a\u0435\u043a\u0442 \u043c\u043e\u0436\u0435\u0442 \u043f\u0440\u043e\u0434\u0430\u0432\u0430\u0442\u044c\u0441\u044f \u0434\u043e\u043b\u0433\u043e"
    },
    "market_risks": {
      "type": "string",
      "description": "\u0420\u0438\u0441\u043a\u0438 \u0440\u044b\u043d\u043a\u0430"
    },
