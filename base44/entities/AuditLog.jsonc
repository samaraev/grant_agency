{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "actor": {
      "type": "string",
      "description": "\u041f\u043e\u0447\u0442\u0430 \u0430\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u043e\u0440\u0430, \u0432\u044b\u043f\u043e\u043b\u043d\u0438\u0432\u0448\u0435\u0433\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435. \u0414\u043b\u044f \u0434\u0435\u043c\u043e-\u0440\u0435\u0436\u0438\u043c\u0430 \u2014 'demo'."
    },
    "action": {
      "type": "string",
      "description": "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440 document.url_issued, document.deleted, lead.exported"
    },
    "entity": {
      "type": "string",
      "description": "\u0421\u0443\u0449\u043d\u043e\u0441\u0442\u044c, \u043a \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0441\u044f \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440 Document"
    },
    "entity_id": {
      "type": "string",
      "description": "\u0418\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0442\u043e\u0440 \u0437\u0430\u043f\u0438\u0441\u0438"
    },
    "meta": {
      "type": "object",
      "description": "\u0414\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0441\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0438"
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "description": "\u041a\u043e\u0433\u0434\u0430 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435"
    }
  },
  "required": [
    "action"
  ],
  "rls": {
