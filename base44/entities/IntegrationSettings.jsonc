{
  "name": "IntegrationSettings",
  "type": "object",
  "properties": {
    "metrica_counter_id": {
      "type": "string",
      "description": "\u041d\u043e\u043c\u0435\u0440 \u0441\u0447\u0451\u0442\u0447\u0438\u043a\u0430 \u042f\u043d\u0434\u0435\u043a\u0441.\u041c\u0435\u0442\u0440\u0438\u043a\u0438. \u041d\u0430\u0447\u0430\u043b\u044c\u043d\u043e\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0438\u0442\u0441\u044f \u0438\u0437 SiteSettings.metrica_counter_id"
    },
    "metrica_goal_ids": {
      "type": "object",
      "description": "\u041a\u0430\u0440\u0442\u0430 \u0446\u0435\u043b\u0435\u0439: lead_submit, phone_click, form_start, qualified_conversation, contract_signed, deal_closed \u2192 \u0447\u0438\u0441\u043b\u043e\u0432\u043e\u0439 ID \u0446\u0435\u043b\u0438 \u0432 \u041c\u0435\u0442\u0440\u0438\u043a\u0435",
      "additionalProperties": true
    },
    "metrica_enabled": {
      "type": "boolean",
      "default": false,
      "description": "\u0421\u0447\u0451\u0442\u0447\u0438\u043a \u0438 \u0446\u0435\u043b\u0438 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u044b. \u041f\u043e\u043a\u0430 false, \u0441\u043a\u0440\u0438\u043f\u0442 \u041c\u0435\u0442\u0440\u0438\u043a\u0438 \u043d\u0430 \u0441\u0430\u0439\u0442\u0435 \u043d\u0435 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0430\u0435\u0442\u0441\u044f \u0438 \u0446\u0435\u043b\u0438 \u043d\u0435 \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u044e\u0442\u0441\u044f"
    },
    "gsc_verification": {
      "type": "string",
      "description": "\u041a\u043e\u0434 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u044f Google Search Console (\u043d\u0435\u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e)"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u041a\u043e\u0433\u0434\u0430 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u043c\u0435\u043d\u044f\u043b\u0438\u0441\u044c \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0439 \u0440\u0430\u0437"
    }
  },
  "required": [],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
