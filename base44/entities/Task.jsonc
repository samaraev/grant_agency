{
  "name": "Task",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string",
      "description": "\u041e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u0435, \u043a \u043a\u043e\u0442\u043e\u0440\u043e\u043c\u0443 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0441\u044f \u0437\u0430\u0434\u0430\u0447\u0430 (\u043d\u0435\u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e)"
    },
    "title": {
      "type": "string",
      "description": "\u0427\u0442\u043e \u043d\u0443\u0436\u043d\u043e \u0441\u0434\u0435\u043b\u0430\u0442\u044c"
    },
    "due_at": {
      "type": "string",
      "description": "\u0421\u0440\u043e\u043a: \u0434\u0430\u0442\u0430 \u0438 \u0432\u0440\u0435\u043c\u044f \u0432 ISO"
    },
    "assignee": {
      "type": "string",
      "description": "\u041e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439: email \u0430\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u043e\u0440\u0430, \u043a\u0430\u043a \u0432 Lead.responsible"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "done",
        "cancelled"
      ],
      "enumColors": [
        "blue",
        "green",
        "gray"
      ],
      "default": "open",
      "description": "\u041e\u0442\u043a\u0440\u044b\u0442\u0430, \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0430 \u0438\u043b\u0438 \u043e\u0442\u043c\u0435\u043d\u0435\u043d\u0430"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high"
      ],
      "enumColors": [
        "gray",
        "blue",
        "red"
      ],
      "default": "normal"
    },
    "reminder_sent": {
      "type": "boolean",
      "default": false,
      "description": "\u041d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0435 \u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u043c\u0443 \u0443\u0436\u0435 \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043e"
    },
    "notes": {
      "type": "string",
      "description": "\u0414\u0435\u0442\u0430\u043b\u0438 \u0437\u0430\u0434\u0430\u0447\u0438"
    },
    "created_by": {
      "type": "string",
      "description": "\u041a\u0442\u043e \u0441\u043e\u0437\u0434\u0430\u043b \u0437\u0430\u0434\u0430\u0447\u0443 (email)"
    },
    "created_at": {
      "type": "string",
      "description": "\u041a\u043e\u0433\u0434\u0430 \u0437\u0430\u0434\u0430\u0447\u0430 \u0441\u043e\u0437\u0434\u0430\u043d\u0430"
    },
    "updated_at": {
      "type": "string",
      "description": "\u041a\u043e\u0433\u0434\u0430 \u0437\u0430\u0434\u0430\u0447\u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0439 \u0440\u0430\u0437 \u043c\u0435\u043d\u044f\u043b\u0430\u0441\u044c"
    }
  },
  "required": [
    "title",
    "due_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}