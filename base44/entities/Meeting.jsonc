{
  "name": "Meeting",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string",
      "description": "\u041e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u0435"
    },
    "type": {
      "type": "string",
      "enum": [
        "in_apartment",
        "office",
        "video"
      ],
      "enumColors": [
        "purple",
        "blue",
        "green"
      ]
    },
    "starts_at": {
      "type": "string",
      "description": "\u0414\u0430\u0442\u0430 \u0438 \u0432\u0440\u0435\u043c\u044f \u0432\u0441\u0442\u0440\u0435\u0447\u0438"
    },
    "address": {
      "type": "string",
      "description": "\u041c\u0435\u0441\u0442\u043e \u0432\u0441\u0442\u0440\u0435\u0447\u0438"
    },
    "responsible": {
      "type": "string",
      "description": "\u041a\u0442\u043e \u0432\u0435\u0434\u0451\u0442 \u0432\u0441\u0442\u0440\u0435\u0447\u0443"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "held",
        "cancelled",
        "no_show"
      ],
      "enumColors": [
        "blue",
        "green",
        "gray",
        "red"
      ],
      "default": "planned"
    },
    "result_notes": {
      "type": "string",
      "description": "\u0418\u0442\u043e\u0433\u0438 \u0432\u0441\u0442\u0440\u0435\u0447\u0438"
    }
  },
  "required": [
    "lead_id",
    "starts_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}