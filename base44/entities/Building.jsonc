{
  "name": "Building",
  "type": "object",
  "properties": {
    "address": {
      "type": "string",
      "description": "\u041f\u043e\u043b\u043d\u044b\u0439 \u0430\u0434\u0440\u0435\u0441 \u043e\u0431\u044a\u0435\u043a\u0442\u0430, \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0439 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440: \u0443\u043b. \u041f\u0440\u0435\u0447\u0438\u0441\u0442\u0435\u043d\u043a\u0430, 17)"
    },
    "city": {
      "type": "string",
      "default": "\u041c\u043e\u0441\u043a\u0432\u0430",
      "description": "\u0413\u043e\u0440\u043e\u0434 \u0438\u043b\u0438 \u0440\u0430\u0439\u043e\u043d \u043e\u0431\u043b\u0430\u0441\u0442\u0438: \u041c\u043e\u0441\u043a\u0432\u0430, \u041c\u043e\u0441\u043a\u043e\u0432\u0441\u043a\u0430\u044f \u043e\u0431\u043b\u0430\u0441\u0442\u044c, \u0434\u0430\u043b\u044c\u0448\u0435 \u2014 \u043d\u043e\u0432\u044b\u0435 \u0433\u043e\u0440\u043e\u0434\u0430 \u043f\u043e \u043c\u0435\u0440\u0435 \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u0438\u044f"
    },
    "property_type": {
      "type": "string",
      "enum": [
        "residential",
        "apartment",
        "penthouse",
        "office",
        "corporate_housing",
        "dacha",
        "estate"
      ],
      "enumColors": [
        "gray",
        "blue",
        "purple",
        "yellow",
        "yellow",
        "green",
        "green"
      ],
      "default": "residential",
      "description": "\u0422\u0438\u043f \u043e\u0431\u044a\u0435\u043a\u0442\u0430: \u0436\u0438\u043b\u043e\u0439 \u0434\u043e\u043c, \u043a\u0432\u0430\u0440\u0442\u0438\u0440\u0430, \u043f\u0435\u043d\u0442\u0445\u0430\u0443\u0441, \u043e\u0444\u0438\u0441, \u043a\u043e\u0440\u043f\u043e\u0440\u0430\u0442\u0438\u0432\u043d\u043e\u0435 \u0436\u0438\u043b\u044c\u0451, \u0434\u0430\u0447\u0430, \u0443\u0441\u0430\u0434\u044c\u0431\u0430"
    },
    "deal_type": {
      "type": "string",
      "enum": [
        "sale",
        "rent"
      ],
      "enumColors": [
        "green",
        "blue"
      ],
      "default": "sale",
      "description": "\u041f\u0440\u043e\u0434\u0430\u0436\u0430 \u0438\u043b\u0438 \u0430\u0440\u0435\u043d\u0434\u0430"
    },
    "price": {
      "type": "number",
      "description": "\u0426\u0435\u043d\u0430 \u0432 \u0440\u0443\u0431\u043b\u044f\u0445 (\u0434\u043b\u044f \u0430\u0440\u0435\u043d\u0434\u044b \u2014 \u0432 \u043c\u0435\u0441\u044f\u0446)"
    },
    "area": {
      "type": "number",
      "description": "\u041f\u043b\u043e\u0449\u0430\u0434\u044c \u043e\u0431\u044a\u0435\u043a\u0442\u0430 \u0432 \u043c\u00b2"
    },
    "district": {
      "type": "string",
      "description": "\u0420\u0430\u0439\u043e\u043d \u0438\u043b\u0438 \u043c\u0438\u043a\u0440\u043e\u0440\u0430\u0439\u043e\u043d"
    },
    "street": {
      "type": "string",
      "description": "\u0423\u043b\u0438\u0446\u0430 \u0431\u0435\u0437 \u043d\u043e\u043c\u0435\u0440\u0430 \u0434\u043e\u043c\u0430"
    },
    "house_number": {
      "type": "string",
      "description": "\u041d\u043e\u043c\u0435\u0440 \u0434\u043e\u043c\u0430"
    },
    "year_built": {
      "type": "number",
      "description": "\u0413\u043e\u0434 \u043f\u043e\u0441\u0442\u0440\u043e\u0439\u043a\u0438"
    },
    "series_or_type": {
      "type": "string",
      "description": "\u0421\u0435\u0440\u0438\u044f \u0438\u043b\u0438 \u0442\u0438\u043f \u0434\u043e\u043c\u0430"
    },
    "floors": {
      "type": "number",
      "description": "\u041a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u044d\u0442\u0430\u0436\u0435\u0439"
    },
    "entrances": {
      "type": "number",
      "description": "\u041a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043f\u043e\u0434\u044a\u0435\u0437\u0434\u043e\u0432"
    },
    "apartments_count": {
      "type": "number",
      "description": "\u041a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043a\u0432\u0430\u0440\u0442\u0438\u0440 \u0438\u043b\u0438 \u043f\u043e\u043c\u0435\u0449\u0435\u043d\u0438\u0439"
    },
    "ceilings": {
      "type": "number",
      "description": "\u0412\u044b\u0441\u043e\u0442\u0430 \u043f\u043e\u0442\u043e\u043b\u043a\u043e\u0432 \u0432 \u043c\u0435\u0442\u0440\u0430\u0445 (\u0438\u0437 \u0441\u043f\u0440\u0430\u0432\u043e\u0447\u043d\u0438\u043a\u0430 \u0430\u0433\u0435\u043d\u0442\u0441\u0442\u0432\u0430)"
    },
    "has_lift": {
      "type": "boolean",
      "description": "\u041d\u0430\u043b\u0438\u0447\u0438\u0435 \u043b\u0438\u0444\u0442\u0430: true \u2014 \u0435\u0441\u0442\u044c, false \u2014 \u043d\u0435\u0442, \u043d\u0435 \u0437\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u043e \u2014 \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e"
    },
    "metro": {
      "type": "string",
      "description": "\u0411\u043b\u0438\u0436\u0430\u0439\u0448\u0438\u0435 \u0441\u0442\u0430\u043d\u0446\u0438\u0438 \u043c\u0435\u0442\u0440\u043e \u0438 \u0432\u0440\u0435\u043c\u044f \u043f\u0435\u0448\u043a\u043e\u043c (\u0438\u0437 \u0441\u043f\u0440\u0430\u0432\u043e\u0447\u043d\u0438\u043a\u0430 \u0430\u0433\u0435\u043d\u0442\u0441\u0442\u0432\u0430)"
    },
    "description": {
      "type": "string",
      "description": "\u0420\u0435\u0434\u0430\u043a\u0446\u0438\u043e\u043d\u043d\u043e\u0435 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u043e\u0431\u044a\u0435\u043a\u0442\u0430"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u041a\u043e\u0440\u043e\u0442\u043a\u0438\u0435 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f: \u043f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u043a\u0438, \u0434\u0432\u043e\u0440, \u043f\u0430\u0440\u043a\u043e\u0432\u043a\u0430, \u0448\u0443\u043c, \u0438\u043d\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0430, \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0421\u0441\u044b\u043b\u043a\u0438 \u043d\u0430 \u0444\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0438"
    },
    "videos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0421\u0441\u044b\u043b\u043a\u0438 \u043d\u0430 \u0432\u0438\u0434\u0435\u043e"
    },
    "is_published": {
      "type": "boolean",
      "default": true,
      "description": "\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u043e\u0431\u044a\u0435\u043a\u0442 \u043d\u0430 \u0441\u0430\u0439\u0442\u0435"
    },
    "is_priority": {
      "type": "boolean",
      "default": false,
      "description": "\u041f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u043d\u044b\u0439 \u0434\u043e\u043c: \u0443 \u0430\u0433\u0435\u043d\u0442\u0441\u0442\u0432\u0430 \u0435\u0441\u0442\u044c \u0441\u0432\u043e\u044f \u044d\u043a\u0441\u043f\u0435\u0440\u0442\u0438\u0437\u0430, \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u044b \u0438 \u0432\u0438\u0434\u0435\u043e"
    },
    "expert_verified": {
      "type": "boolean",
      "default": false,
      "description": "\u0414\u0430\u043d\u043d\u044b\u0435 \u043e \u0434\u043e\u043c\u0435 \u043f\u0440\u043e\u0432\u0435\u0440\u0435\u043d\u044b \u044d\u043a\u0441\u043f\u0435\u0440\u0442\u043e\u043c \u0430\u0433\u0435\u043d\u0442\u0441\u0442\u0432\u0430"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "\u0414\u043e\u043c \u0432\u0445\u043e\u0434\u0438\u0442 \u0432 \u0438\u0437\u0431\u0440\u0430\u043d\u043d\u0443\u044e \u043f\u043e\u0434\u0431\u043e\u0440\u043a\u0443 \u0433\u043b\u0430\u0432\u043d\u043e\u0439 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u044b"
    },
    "featured_order": {
      "type": "number",
      "description": "\u041f\u043e\u0440\u044f\u0434\u043e\u043a \u0434\u043e\u043c\u0430 \u0432 \u0438\u0437\u0431\u0440\u0430\u043d\u043d\u043e\u0439 \u043f\u043e\u0434\u0431\u043e\u0440\u043a\u0435 \u0433\u043b\u0430\u0432\u043d\u043e\u0439 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u044b"
    },
    "neighborhood_group": {
      "type": "string",
      "enum": [
        "park_kultury",
        "frunzenskaya",
        "plushchiha",
        "other"
      ],
      "enumColors": [
        "green",
        "blue",
        "purple",
        "gray"
      ],
      "default": "other",
      "description": "\u0413\u0440\u0443\u043f\u043f\u0430 \u0440\u0430\u0439\u043e\u043d\u0430 \u0434\u043b\u044f \u0444\u0438\u043b\u044c\u0442\u0440\u043e\u0432 \u043f\u043e\u0434\u0431\u043e\u0440\u043a\u0438: \u0443 \u041f\u0430\u0440\u043a\u0430 \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u044b, \u0424\u0440\u0443\u043d\u0437\u0435\u043d\u0441\u043a\u0430\u044f, \u041f\u043b\u044e\u0449\u0438\u0445\u0430"
    },
    "source_url": {
      "type": "string",
      "description": "\u0421\u0441\u044b\u043b\u043a\u0430 \u043d\u0430 \u0437\u0430\u043f\u0438\u0441\u044c \u0434\u043e\u043c\u0430 \u0432 \u0441\u043f\u0440\u0430\u0432\u043e\u0447\u043d\u0438\u043a\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044e\u0449\u0435\u0433\u043e \u0441\u0430\u0439\u0442\u0430 \u0430\u0433\u0435\u043d\u0442\u0441\u0442\u0432\u0430"
    },
    "verified_at": {
      "type": "string",
      "description": "\u0414\u0430\u0442\u0430 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438 \u0434\u0430\u043d\u043d\u044b\u0445"
    },
    "verified_by": {
      "type": "string",
      "description": "\u041a\u0442\u043e \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u043b"
    },
    "updated_at": {
      "type": "string",
      "description": "\u0414\u0430\u0442\u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0433\u043e \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f \u0434\u0430\u043d\u043d\u044b\u0445 \u043e\u0431 \u043e\u0431\u044a\u0435\u043a\u0442\u0435"
    }
  },
