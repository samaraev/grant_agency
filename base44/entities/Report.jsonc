{
  "name": "Report",
  "type": "object",
  "properties": {
    "period_type": {
      "type": "string",
      "enum": [
        "week",
        "month"
      ],
      "enumColors": [
        "blue",
        "purple"
      ],
      "default": "week",
      "description": "\u0422\u0438\u043f \u043e\u0442\u0447\u0451\u0442\u0430: \u043d\u0435\u0434\u0435\u043b\u044c\u043d\u044b\u0439 \u0438\u043b\u0438 \u043c\u0435\u0441\u044f\u0447\u043d\u044b\u0439"
    },
    "period_start": {
      "type": "string",
      "description": "\u041d\u0430\u0447\u0430\u043b\u043e \u043f\u0435\u0440\u0438\u043e\u0434\u0430 (ISO)"
    },
    "period_end": {
      "type": "string",
      "description": "\u041a\u043e\u043d\u0435\u0446 \u043f\u0435\u0440\u0438\u043e\u0434\u0430 (ISO)"
    },
    "metrics": {
      "type": "string",
      "description": "\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043f\u043e\u0441\u0447\u0438\u0442\u0430\u043d\u043d\u044b\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0438 \u043f\u0435\u0440\u0438\u043e\u0434\u0430 \u0432 JSON"
    },
    "done_text": {
      "type": "string",
      "description": "\u0427\u0442\u043e \u0441\u0434\u0435\u043b\u0430\u043d\u043e"
    },
    "implemented_text": {
      "type": "string",
      "description": "\u0427\u0442\u043e \u0432\u043d\u0435\u0434\u0440\u0435\u043d\u043e"
    },
    "checked_text": {
      "type": "string",
      "description": "\u0427\u0442\u043e \u043f\u0440\u043e\u0432\u0435\u0440\u0435\u043d\u043e"
    },
    "data_text": {
      "type": "string",
      "description": "\u041a\u0430\u043a\u0438\u0435 \u0434\u0430\u043d\u043d\u044b\u0435 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u044b"
    },
    "blocked_text": {
      "type": "string",
      "description": "\u0427\u0442\u043e \u0437\u0430\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u043d\u043e"
    },
    "next_text": {
      "type": "string",
      "description": "\u0427\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u043c \u0434\u0430\u043b\u044c\u0448\u0435"
    },
    "sent_at": {
      "type": "string",
      "description": "\u041a\u043e\u0433\u0434\u0430 \u043e\u0442\u0447\u0451\u0442 \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u0435\u043d \u043f\u043e \u043f\u043e\u0447\u0442\u0435"
    },
    "author": {
      "type": "string",
      "description": "\u041a\u0442\u043e \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u0438\u043b \u043e\u0442\u0447\u0451\u0442 (email)"
    }
  },
  "required": [
    "period_type",
    "period_start"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}