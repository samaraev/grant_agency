{
  "name": "SequenceSetting",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "enum": [
        "first_reply",
        "meeting_confirmation",
        "no_answer",
        "price_analysis_followup",
        "thank_you_after_meeting"
      ],
      "enumColors": [
        "blue",
        "purple",
        "yellow",
        "green",
        "green"
      ],
      "description": "\u0421\u0446\u0435\u043d\u0430\u0440\u0438\u0439 \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438. \u0421\u043e\u0432\u043f\u0430\u0434\u0430\u0435\u0442 \u0441 \u0442\u0440\u0438\u0433\u0433\u0435\u0440\u043e\u043c \u043f\u043e \u0441\u0442\u0430\u0442\u0443\u0441\u0443 \u043e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u044f."
    },
    "channel": {
      "type": "string",
      "enum": [
        "email",
        "sms",
        "whatsapp"
      ],
      "enumColors": [
        "blue",
        "gray",
        "green"
      ],
      "description": "\u041a\u0430\u043d\u0430\u043b \u043e\u0442\u043f\u0440\u0430\u0432\u043a\u0438"
    },
    "template_key": {
      "type": "string",
      "description": "\u0418\u043c\u044f \u0448\u0430\u0431\u043b\u043e\u043d\u0430 \u0438\u0437 MessageTemplate (name) \u0432\u043d\u0443\u0442\u0440\u0438 \u044d\u0442\u043e\u0433\u043e \u043a\u0430\u043d\u0430\u043b\u0430"
    },
    "auto_send": {
      "type": "boolean",
      "default": false,
      "description": "\u041e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0442\u044c \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043f\u0440\u0438 \u0441\u043c\u0435\u043d\u0435 \u0441\u0442\u0430\u0442\u0443\u0441\u0430 \u043e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u044f"
    },
    "delay_hours": {
      "type": "number",
      "default": 0,
      "description": "\u0417\u0430\u0434\u0435\u0440\u0436\u043a\u0430 \u043f\u0435\u0440\u0435\u0434 \u043e\u0442\u043f\u0440\u0430\u0432\u043a\u043e\u0439 \u0432 \u0447\u0430\u0441\u0430\u0445. \u0411\u043e\u043b\u044c\u0448\u0435 \u043d\u0443\u043b\u044f \u2014 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u0443\u0445\u043e\u0434\u0438\u0442 \u0432 \u043e\u0447\u0435\u0440\u0435\u0434\u044c."
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u0421\u0446\u0435\u043d\u0430\u0440\u0438\u0439 \u0432\u043a\u043b\u044e\u0447\u0451\u043d"
    }
  },
  "required": [
    "key",
    "channel"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}