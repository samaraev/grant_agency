{
  "name": "AdminSettings",
  "type": "object",
  "properties": {
    "target_districts": {
      "type": "string",
      "default": "\u0425\u0430\u043c\u043e\u0432\u043d\u0438\u043a\u0438",
      "description": "\u0426\u0435\u043b\u0435\u0432\u044b\u0435 \u0440\u0430\u0439\u043e\u043d\u044b \u0440\u0430\u0431\u043e\u0442\u044b"
    },
    "target_streets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0426\u0435\u043b\u0435\u0432\u044b\u0435 \u0443\u043b\u0438\u0446\u044b"
    },
    "first_response_sla_minutes": {
      "type": "number",
      "default": 30,
      "description": "\u041d\u043e\u0440\u043c\u0430\u0442\u0438\u0432 \u043f\u0435\u0440\u0432\u043e\u0433\u043e \u043e\u0442\u0432\u0435\u0442\u0430, \u043c\u0438\u043d\u0443\u0442\u044b"
    },
    "working_hours_start": {
      "type": "string",
      "default": "10:00"
    },
    "working_hours_end": {
      "type": "string",
      "default": "20:00"
    },
    "timezone": {
      "type": "string",
      "default": "Europe/Moscow"
    },
    "default_responsible": {
      "type": "string",
      "description": "\u041e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e (email)"
    },
    "backup_responsible": {
      "type": "string",
      "description": "\u0420\u0435\u0437\u0435\u0440\u0432\u043d\u044b\u0439 \u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 (email)"
    },
    "sms_provider": {
      "type": "string",
      "enum": [
        "none",
        "smsru",
        "smsc",
        "twilio"
      ],
      "enumColors": [
        "gray",
        "blue",
        "green",
        "purple"
      ],
      "default": "none",
      "description": "\u041f\u0440\u043e\u0432\u0430\u0439\u0434\u0435\u0440 SMS. \u041a\u043b\u044e\u0447\u0438 \u0445\u0440\u0430\u043d\u044f\u0442\u0441\u044f \u0432 \u0441\u0435\u043a\u0440\u0435\u0442\u0430\u0445 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f."
    },
    "sms_sender": {
      "type": "string",
      "description": "\u0418\u043c\u044f \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u0435\u043b\u044f SMS (\u043f\u043e\u0434\u043f\u0438\u0441\u044c), \u0435\u0441\u043b\u0438 \u043f\u0440\u043e\u0432\u0430\u0439\u0434\u0435\u0440 \u0435\u0451 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442"
    },
    "telephony_provider": {
      "type": "string",
      "enum": [
        "none",
        "zadarma",
        "novofon",
        "telphin",
        "mango"
      ],
      "enumColors": [
        "gray",
        "blue",
        "green",
        "yellow",
        "purple"
      ],
      "default": "none",
      "description": "\u041f\u0440\u043e\u0432\u0430\u0439\u0434\u0435\u0440 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0438\u0438 \u0434\u043b\u044f \u0437\u0432\u043e\u043d\u043a\u0430 \u0432 \u0434\u0432\u0430 \u0448\u0430\u0433\u0430: \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u0430\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u043e\u0440\u0443, \u0437\u0430\u0442\u0435\u043c \u043a\u043b\u0438\u0435\u043d\u0442\u0443"
    },
    "call_first_number": {
      "type": "string",
      "description": "\u041d\u043e\u043c\u0435\u0440 \u0430\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u043e\u0440\u0430, \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u0440\u043e\u0432\u0430\u0439\u0434\u0435\u0440 \u0437\u0432\u043e\u043d\u0438\u0442 \u043f\u0435\u0440\u0432\u044b\u043c, \u0438 \u043d\u043e\u043c\u0435\u0440 \u0434\u043b\u044f \u0442\u0435\u0441\u0442\u043e\u0432\u043e\u0439 SMS"
    },
    "email_from_name": {
      "type": "string",
      "description": "\u0418\u043c\u044f \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u0435\u043b\u044f \u043f\u0438\u0441\u0435\u043c \u0438\u0437 \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0438 \u043e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u044f"
    },
    "comms_webhook_path": {
      "type": "string",
      "description": "\u0424\u0443\u043d\u043a\u0446\u0438\u044f-\u043f\u0440\u0438\u0451\u043c\u043d\u0438\u043a \u0441\u0442\u0430\u0442\u0443\u0441\u043e\u0432 \u0441\u0432\u044f\u0437\u0438 (\u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e commsWebhook)"
    },
    "digest_enabled": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {}
  }
}