{
  "name": "MessageTemplate",
  "type": "object",
  "properties": {
    "channel": {
      "type": "string",
      "enum": [
        "email",
        "sms",
        "messenger"
      ],
      "enumColors": [
        "blue",
        "gray",
        "purple"
      ]
    },
    "name": {
      "type": "string",
      "description": "\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0448\u0430\u0431\u043b\u043e\u043d\u0430"
    },
    "subject": {
      "type": "string",
      "description": "\u0422\u0435\u043c\u0430 \u043f\u0438\u0441\u044c\u043c\u0430 (\u0434\u043b\u044f email)"
    },
    "body": {
      "type": "string",
      "description": "\u0422\u0435\u043a\u0441\u0442 \u0441 \u043f\u043e\u043b\u044f\u043c\u0438 \u043f\u043e\u0434\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438: {\u0438\u043c\u044f} {\u0430\u0434\u0440\u0435\u0441} {\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439} {\u0432\u0440\u0435\u043c\u044f_\u0432\u0441\u0442\u0440\u0435\u0447\u0438}"
    }
  },
  "required": [
    "channel",
    "name",
    "body"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {}
  }
}