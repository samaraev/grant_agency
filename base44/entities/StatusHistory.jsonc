{
  "name": "StatusHistory",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string",
      "description": "\u041e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u0435"
    },
    "from_status": {
      "type": "string",
      "description": "\u041f\u0440\u0435\u0434\u044b\u0434\u0443\u0449\u0438\u0439 \u0441\u0442\u0430\u0442\u0443\u0441"
    },
    "to_status": {
      "type": "string",
      "description": "\u041d\u043e\u0432\u044b\u0439 \u0441\u0442\u0430\u0442\u0443\u0441"
    },
    "changed_by": {
      "type": "string",
      "description": "\u041a\u0442\u043e \u0438\u0437\u043c\u0435\u043d\u0438\u043b (email \u0430\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u043e\u0440\u0430)"
    },
    "note": {
      "type": "string",
      "description": "\u041a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0439 \u043a \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u0443"
    }
  },
  "required": [
    "lead_id",
    "to_status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
