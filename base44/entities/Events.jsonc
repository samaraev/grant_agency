{
  "name": "Events",
  "type": "object",
  "properties": {
    "event_name": {
      "type": "string",
      "description": "page_view | address_search | building_view | cta_click | lead_submit"
    },
    "path": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "building_id": {
      "type": "string"
    },
    "search_query": {
      "type": "string"
    },
    "matched": {
      "type": "boolean",
      "description": "\u0414\u043b\u044f address_search: \u043d\u0430\u0448\u0451\u043b\u0441\u044f \u043b\u0438 \u0430\u0434\u0440\u0435\u0441 \u0432 \u0431\u0430\u0437\u0435"
    },
    "meta": {
      "type": "string",
      "description": "\u0414\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u044b \u0441\u043e\u0431\u044b\u0442\u0438\u044f \u0432 \u0432\u0438\u0434\u0435 JSON"
    }
  },
  "required": [
    "event_name"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}